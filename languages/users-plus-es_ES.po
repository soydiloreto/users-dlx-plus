#~ msgstr "Verlos"

#, php-format
#~ msgid "Sign in with %s"
#~ msgstr "Entrar con %s"

#~ msgid ""
#~ "To let people sign in with their %s account you first have to create an "
#~ "app there. It takes three steps."
#~ msgstr ""
#~ "Para que la gente entre con su cuenta de %s primero hay que crear una "
#~ "aplicación ahí. Son tres pasos."

#~ msgid "Create the app"
#~ msgstr "Crear la aplicación"

#~ msgid "In the developer console:"
#~ msgstr "En la consola de desarrolladores:"

#~ msgid "Load the redirect URL"
#~ msgstr "Cargar la URL de retorno"

#~ msgid ""
#~ "The app asks where to send people back. Paste this one, exactly as it is:"
#~ msgstr ""
#~ "La aplicación pregunta adónde devolver a la persona. Pegá ésta, tal cual "
#~ "está:"

#~ msgid "Some providers call it callback URL, or authorized redirect URI."
#~ msgstr ""
#~ "Algunos proveedores la llaman callback URL, o authorized redirect URI."

#~ msgid "Copy the credentials here"
#~ msgstr "Copiar las credenciales acá"

#~ msgid ""
#~ "The app gives you a client ID and a secret. Paste them in Settings and "
#~ "turn the button on."
#~ msgstr ""
#~ "La aplicación te da un ID de cliente y un secreto. Pegalos en Ajustes y "
#~ "prendé el botón."

#~ msgid "Heads up"
#~ msgstr "Ojo con esto"

#~ msgid ""
#~ "X never returns the email address. It can be linked to an account that is "
