#~ msgstr "Borrar la cuenta"

#~ msgid "Download the data"
#~ msgstr "Descargar los datos"

#~ msgid "Closed: wp-login.php sends people to the sign-in page."
#~ msgstr "Cerrada: wp-login.php manda a la página de acceso."

