msgstr "Ese código no es correcto, o venció. Probá con el que sigue."

#: templates/login-2fa.php:21
msgid "Sent. Check your email."
msgstr "Mandado. Mirá tu correo."

#: templates/login-2fa.php:29
msgid "The code"
msgstr "El código"

