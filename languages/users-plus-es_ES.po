msgid ""
"We could not finish signing you in with that provider. Try again or use your "
"email."
msgstr ""
"No pudimos completar el ingreso con esa red. Probá de nuevo o usá tu correo."

#: templates/login.php:47
msgid "Something went wrong. Try again."
msgstr "Algo salió mal. Probá de nuevo."

